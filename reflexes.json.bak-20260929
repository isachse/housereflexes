{
  "housevitals": {
    "url": "http://127.0.0.1:8080",
    "token_file": "~/.config/housevitals/control.token"
  },
  "timezone": "Europe/Berlin",
  "interval_s": 60,
  "status_interval_s": 1800,
  "dry_run": false,
  "state_file": "~/.local/state/housereflexes/state.json",
  "reflexes": [
    {
      "name": "dhw_pv_boost",
      "type": "pv_surplus_boost",
      "enabled": true,
      "target": {
        "appliance": "heatpump2",
        "key": "dhw_setpoint_min",
        "value": 45
      },
      "boost": {
        "max_duration_s": 10800,
        "min_duration_s": 1800,
        "latest_end": "18:00"
      },
      "source": {
        "appliance": "inverter",
        "battery_soc": "battery_soc",
        "grid_power": "grid_power",
        "battery_power": "battery_power"
      },
      "arm": {
        "min_battery_soc": 90,
        "min_export_w": 2500,
        "hold_s": 600
      },
      "done": {
        "appliance": "heatpump2",
        "key": "dhw_temperature",
        "min": 49,
        "start_below": 44
      },
      "abort": {
        "max_deficit_w": 500,
        "hold_s": 300
      },
      "max_per_day": 1
    }
  ]
}
